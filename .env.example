# ===== Telegram =====
# Токен бота от @BotFather (ХРАНИТЬ В СЕКРЕТЕ, не коммитить!)
BOT_TOKEN=1234567890:AAA-your-bot-token-here

# Telegram ID администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=123456789

# ===== База данных =====
# Для локального тестирования (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Для продакшена (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://steambot:steambot@localhost:5432/steambot

# ===== Настройки отображения =====
# Таймзона для отображения дат (IANA name)
DISPLAY_TZ=Asia/Almaty

# Номер Kaspi, показываемый в меню пожертвований (обычный текст, НЕ кнопка)
KASPI_NUMBER=7 708 130 1674

# Стартовые размеры пожертвований в Stars (настраиваются и из админки)
DONATION_PRESETS=25,50,100,250,500

# ===== Логи =====
LOG_LEVEL=INFO

# ===== Для хостинга типа Hugging Face Spaces / Render =====
# Порт mini-HTTP-сервера health-check. Локально оставьте 0 (выключен),
# в Space укажите переменную HEALTH_PORT=7860
HEALTH_PORT=0

# ===== Webhook-режим (Render и другие PaaS) =====
# Локально оставьте пустым — бот работает через long polling.
# На Render заполните так (Render сам подставит PORT):
# WEBHOOK_URL=https://ваш-сервис.onrender.com/webhook
# WEBHOOK_SECRET=случайная-строка-секрет
# PORT(Render подставит сам) / WEBHOOK_REGISTER=false — только для тестов
WEBHOOK_URL=
WEBHOOK_SECRET=

# ===== Только для docker-compose (PostgreSQL) =====
# POSTGRES_USER=steambot
# POSTGRES_PASSWORD=steambot
# POSTGRES_DB=steambot
